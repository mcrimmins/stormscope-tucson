# Copy to s3.env (git-ignored) and adjust if needed. Used by sync_s3.sh.
S3_BUCKET=cales-climate-reports
S3_PREFIX=climate/stormscope          # site lives at s3://cales-climate-reports/climate/stormscope/
AWS_PROFILE=                          # leave empty to use the default AWS CLI credentials
AWS_REGION=
CLOUDFRONT_ID=                        # only if cales.arizona.edu/climate is served through CloudFront
SITE_URL=https://cales.arizona.edu/climate/stormscope/
